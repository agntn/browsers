{
  "name": "docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --extends docus",
    "build": "NUXT_SITE_URL=https://browsers.agntn.dev nuxt build --extends docus",
    "generate": "NUXT_SITE_URL=https://browsers.agntn.dev nuxt generate --extends docus",
