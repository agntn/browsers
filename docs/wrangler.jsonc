{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agntn-browsers",
  "account_id": "6ef8d3cbe19975e93d994f25228488e7",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NUXT_SITE_URL": "https://browsers.agntn.dev"
  },
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agntn-browsers",
      "database_id": "6cccdc0d-22ef-4f09-878c-8dca06b26fdb"
    }
  ],
  "routes": [{ "pattern": "browsers.agntn.dev", "custom_domain": true }],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
