{
  "name": "@agntn/browsers",
  "version": "0.2.0",
  "description": "Unified browser-as-a-service provider for AI agents and CLI.",
  "keywords": [
    "agent",
    "anchor",
    "automation",
    "browser",
    "browserbase",
    "browserless",
    "cdp",
    "cli",
    "headless",
    "hyperbrowser",
    "kernel",
    "pi-extension",
    "pi-package",
    "providers",
    "scrape",
    "screenshot",
    "steel",
    "typescript",
    "unified"
  ],
  "homepage": "https://github.com/agntn/browsers#readme",
  "bugs": "https://github.com/agntn/browsers/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agntn/browsers.git"
  },
  "bin": {
    "browsers": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "packages/omp/extensions",
    "packages/pi/extensions",
    "packages/shared",
    "src/tool-contract.ts",
    "src/tool-schemas.ts"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "lint": "pnpm build && oxlint . && oxfmt --check .",
    "lint:fix": "pnpm build && oxlint . --fix && oxfmt .",
    "typecheck": "tsc --noEmit && pnpm build && tsc --noEmit -p tsconfig.extensions.json",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:mcp": "pnpm build && node test/eval-mcp.mjs",
    "prepack": "pnpm run build",
    "release": "pnpm test:run && pnpm build && changelogen --release --push"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "citty": "latest",
    "consola": "latest",
    "ofetch": "1.5.1",
    "playwright": "1.60.0",
    "string-width": "7.2.0",
    "strip-ansi": "7.2.0",
    "typebox": "1.3.14"
  },
  "devDependencies": {
    "@agntn/ox": "0.1.0",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@oh-my-pi/omptype": "18.0.0",
    "@oh-my-pi/pi-coding-agent": "18.0.0",
    "@types/node": "latest",
    "changelogen": "latest",
    "obuild": "latest",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "4.22.3",
    "typescript": "latest",
    "vitest": "latest"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.76.0 <1",
    "@earendil-works/pi-tui": ">=0.76.0 <1",
    "@oh-my-pi/pi-coding-agent": ">=18.0.0 <19",
    "typebox": ">=1.3.14 <2"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.4",
  "omp": {
    "extensions": [
      "./packages/omp/extensions/browsers.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./packages/pi/extensions/*.ts"
    ]
  }
}
