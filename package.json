{
  "name": "@agntn/browsers",
  "version": "0.5.0",
  "description": "Unified browser-as-a-service provider for AI agents and CLI.",
  "keywords": [
    "agent",
    "anchor",
    "automation",
    "browser",
    "browserbase",
    "browserless",
    "cdp",
    "cli",
    "headless",
    "hyperbrowser",
    "kernel",
    "pi-extension",
    "pi-package",
    "providers",
    "scrape",
    "screenshot",
    "steel",
    "typescript",
    "unified"
  ],
  "homepage": "https://browsers.agntn.dev",
  "bugs": "https://github.com/agntn/browsers/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agntn/browsers.git"
  },
  "bin": {
    "browsers": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "packages/omp/extensions",
    "packages/pi/extensions",
    "packages/shared",
    "src/tool-contract.ts",
    "src/tool-schemas.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.mts",
      "import": "./dist/providers/*.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "lint": "pnpm build && vp lint && vp fmt --check",
    "lint:fix": "pnpm build && vp lint --fix && vp fmt",
    "typecheck": "tsc --noEmit && pnpm build && tsc --noEmit -p tsconfig.extensions.json",
    "test": "vp test watch",
    "test:run": "vp test run",
    "test:mcp": "pnpm build && node test/eval-mcp.mjs",
    "prepack": "pnpm run build",
    "release": "pnpm build && pnpm test:run && changelogen --release --push"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "citty": "0.2.2",
    "consola": "3.4.2",
    "ofetch": "1.5.1",
    "playwright-core": "1.60.0",
    "string-width": "7.2.0",
    "strip-ansi": "7.2.0"
  },
  "devDependencies": {
    "@agntn/ox": "0.1.0",
    "@earendil-works/pi-coding-agent": "0.76.0",
    "@earendil-works/pi-tui": "0.76.0",
    "@oh-my-pi/omptype": "18.0.0",
    "@oh-my-pi/pi-coding-agent": "18.0.0",
    "@types/node": "latest",
    "changelogen": "latest",
    "tsx": "4.22.5",
    "typebox": "1.3.34",
    "typescript": "latest",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.76.0 <1",
    "@earendil-works/pi-tui": ">=0.76.0 <1",
    "@oh-my-pi/pi-coding-agent": ">=18.0.0 <19",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.33.4",
  "omp": {
    "extensions": [
      "./packages/omp/extensions/browsers.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./packages/pi/extensions/*.ts"
    ]
  }
}
