{
  "name": "@agntn/browsers",
  "version": "0.6.1",
  "description": "Unified browser-as-a-service provider for AI agents and CLI.",
  "keywords": [
    "agent",
    "anchor",
    "automation",
    "browser",
    "browserbase",
    "browserless",
    "cdp",
    "cli",
    "headless",
    "hyperbrowser",
    "kernel",
    "pi-extension",
    "pi-package",
    "providers",
    "scrape",
    "screenshot",
    "steel",
    "typescript",
    "unified"
  ],
  "homepage": "https://browsers.agntn.dev",
  "bugs": "https://github.com/agntn/browsers/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agntn/browsers.git"
  },
  "bin": {
    "browsers": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "extensions/omp",
    "extensions/pi",
    "extensions/shared",
    "src/tool-contract.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./ai": {
      "types": "./dist/ai.d.mts",
      "import": "./dist/ai.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.mts",
      "import": "./dist/providers/*.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "lint": "pnpm build && vp lint && vp fmt --check",
    "lint:fix": "pnpm build && vp lint --fix && vp fmt",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json && pnpm build && tsc --noEmit -p tsconfig.extensions.json",
    "test": "vp test watch",
    "test:run": "vp test run",
    "test:mcp": "pnpm build && node test/eval-mcp.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@agntn/credentials": "catalog:deps",
    "@agntn/tools": "catalog:deps",
    "@modelcontextprotocol/server": "catalog:deps",
    "playwright-core": "catalog:deps",
    "string-width": "catalog:deps",
    "strip-ansi": "catalog:deps"
  },
  "devDependencies": {
    "@agntn/ox": "catalog:dev",
    "@earendil-works/pi-coding-agent": "catalog:dev",
    "@earendil-works/pi-tui": "catalog:dev",
    "@modelcontextprotocol/client": "catalog:dev",
    "@oh-my-pi/omptype": "catalog:dev",
    "@oh-my-pi/pi-coding-agent": "catalog:dev",
    "@types/node": "catalog:dev",
    "ai": "catalog:dev",
    "obuild": "catalog:dev",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2 <2",
    "@earendil-works/pi-tui": ">=0.76.0 <2",
    "@oh-my-pi/pi-coding-agent": ">=18.0.0 <19",
    "ai": ">=7.0.0 <8"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0",
  "omp": {
    "extensions": [
      "./extensions/omp/browsers.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./extensions/pi/*.ts"
    ]
  }
}
